# Base URL used to build the per-platform OAuth redirect URIs.
# The backend will append /<platform>/callback, e.g. 
REDIRECT_URI_BASE=http://127.0.0.1:8000/api/auth

# Frontend app; the OAuth callback redirects back here after a successful/error flow.
# Must share the same host as REDIRECT_URI_BASE so the plm_session cookie is
# attached (SameSite=Lax), e.g. both on 127.0.0.1 or both on localhost.
FRONTEND_BASE_URL=http://127.0.0.1:4200

# Allowed browser origins for API calls (CORS). Comma separated.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Lifetime of the in-memory dev session (in seconds). Defaults to 7 days.
SESSION_TTL_SECONDS=604800

# Spotify app credentials (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=KEY
SPOTIFY_CLIENT_SECRET=KEY

# YouTube / Google Cloud OAuth 2.0 credentials (https://console.cloud.google.com/apis/credentials)
YOUTUBE_CLIENT_ID=KEY
YOUTUBE_CLIENT_SECRET=KEY

# Optional: override the default OAuth scopes (space separated for Spotify, full URLs for Google).
# SPOTIFY_SCOPES=playlist-read-private playlist-read-collaborative
# YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube
